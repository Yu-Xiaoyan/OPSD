#!/bin/bash
#PBS -N opsd_noguard_1b
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=12:ngpus=3
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

module purge
module load anaconda/2025
module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate opsd

cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1
# No 12.x CUDA module exists (only cuda/13.0, cuda/13.1); torch 2.8.0 is cu128, so
# DeepSpeed's CPUAdam JIT build fails the strict version check. Skip it.
export DS_SKIP_CUDA_CHECK=1
# anaconda/2025 CPATH carries a second torch that collides with the opsd env's
# headers during the CPUAdam build; drop the polluted include env.
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

mkdir -p pbs/logs
exec > "pbs/logs/opsd_noguard_1b.${PBS_JOBID}.log" 2>&1

echo "Job: ${PBS_JOBID}  Node: $(hostname)  GPU: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L
echo "nvcc: $(which nvcc) $(nvcc --version | tail -1)"

# Experiment A: no-guard ablation (neutral transition prompt). Baseline for
# comparison = the main repro run qwen31b_repro_3xh200_gb30.
bash scripts/run_opsd_1b_3gpu_noguard.sh

echo "=== DONE ==="
