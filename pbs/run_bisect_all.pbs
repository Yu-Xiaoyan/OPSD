#!/bin/bash
#PBS -N bisect_all
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=12:ngpus=3
#PBS -l walltime=14:00:00
#PBS -j oe

set -uo pipefail

module purge
module load anaconda/2025
module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate opsd

cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1
export DS_SKIP_CUDA_CHECK=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

mkdir -p pbs/logs
exec > "pbs/logs/bisect_all.${PBS_JOBID}.log" 2>&1

echo "Job: ${PBS_JOBID}  Node: $(hostname)  GPU: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L
df -h ~ | tail -1

# Fixed matrix, serial overnight (order is scheduling-only, no scientific meaning):
# clip -> guard -> length -> tmoff. Each is Tier 1 with ONE knob restored to repo.
for V in clip guard length tmoff; do
    echo "======================================================================"
    echo "=== BISECT VARIANT: ${V}  ($(date)) ==="
    echo "======================================================================"
    set +e
    bash "scripts/run_bisect_${V}.sh"
    echo "=== bisect ${V} exit: $? ==="
    set -e
    # settle GPUs between runs (release vLLM/DS memory before the next launch)
    sleep 30
    nvidia-smi --query-gpu=memory.used --format=csv,noheader || true
done

echo "=== ALL BISECT VARIANTS DONE ($(date)) ==="
