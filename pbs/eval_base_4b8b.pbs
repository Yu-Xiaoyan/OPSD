#!/bin/bash
#PBS -N eval_base
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=16:ngpus=2
#PBS -l walltime=08:00:00
#PBS -j oe
# 4B base + 8B base 单点 (AIME24/25 avg@12, 无训练 base 参照). 2卡, 顺序跑两个 base.
set -uo pipefail
module purge; module load anaconda/2025; module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"; conda activate opsd
cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 NCCL_P2P_DISABLE=1 DS_SKIP_CUDA_CHECK=1
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
  n=$(echo "${CUDA_VISIBLE_DEVICES}"|tr ',' '\n'|wc -l); CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((n-1))); export CUDA_VISIBLE_DEVICES
fi
mkdir -p pbs/logs results/opsd_eval
exec > "pbs/logs/eval_base_4b8b.${PBS_JOBID}.log" 2>&1
echo "Job ${PBS_JOBID} $(hostname)"; nvidia-smi -L
echo "=== 4B base AIME24/25 avg@12 ==="
BASE_MODEL="$HOME/models/Qwen3-4B" MODEL_DIR="" TAG="4bbase" OUT="results/opsd_eval" DATASETS="aime24 aime25" VAL_N=12 STEPS="" NGPU=2 bash scripts/run_eval_matrix.sh
echo "=== 8B base AIME24/25 avg@12 ==="
BASE_MODEL="$HOME/models/Qwen3-8B" MODEL_DIR="" TAG="8bbase" OUT="results/opsd_eval" DATASETS="aime24 aime25" VAL_N=12 STEPS="" NGPU=2 bash scripts/run_eval_matrix.sh
echo "=== DONE ==="
