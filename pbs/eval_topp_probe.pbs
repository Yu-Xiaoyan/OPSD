#!/bin/bash
#PBS -N eval_topp_probe
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=6:ngpus=1
#PBS -l walltime=01:30:00
#PBS -j oe

# Probe: does top_p=0.95 (eval/run_eval.sh's auto-default) reproduce the official
# base AIME24 score (51.5 +/- 1.5) better than top_p=1.0 (the documented "top-p
# none")? Same protocol otherwise: temp=1.0, thinking on, max_new_tokens=38912,
# top-k off, min-p 0, val_n=12. The top_p=1.0 base/aime24 datapoint comes from the
# main eval job (results/repro_eval/base_aime24.json); this writes a separate file.

set -uo pipefail

module purge
module load anaconda/2025
module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate opsd

cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1
export NCCL_P2P_DISABLE=1
export DS_SKIP_CUDA_CHECK=1
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

mkdir -p pbs/logs results/repro_eval
exec > "pbs/logs/eval_topp_probe.${PBS_JOBID}.log" 2>&1

echo "Job: ${PBS_JOBID}  Node: $(hostname)  GPU: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L

"$HOME/.conda/envs/opsd/bin/python" eval/evaluate_math.py \
    --base_model "$HOME/models/Qwen3-1.7B" \
    --dataset aime24 \
    --val_n 12 \
    --temperature 1.0 \
    --top_p 0.95 \
    --top_k -1 \
    --min_p 0 \
    --presence_penalty 0 \
    --max_new_tokens 38912 \
    --tensor_parallel_size 1 \
    --gpu_memory_utilization 0.9 \
    --output_file results/repro_eval/base_aime24_topp095.json

echo "=== DONE ==="
