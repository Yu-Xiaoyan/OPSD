#!/bin/bash
#PBS -N corrqual
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
set -uo pipefail
module purge; module load anaconda/2025; module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"; conda activate opsd
cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 DS_SKIP_CUDA_CHECK=1
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
  n=$(echo "${CUDA_VISIBLE_DEVICES}"|tr ',' '\n'|wc -l); CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((n-1))); export CUDA_VISIBLE_DEVICES
fi
mkdir -p pbs/logs probes/analysis
exec > "pbs/logs/corrqual.${PBS_JOBID}.log" 2>&1
echo "Job ${PBS_JOBID} $(hostname)"; nvidia-smi -L
PY=~/.conda/envs/opsd/bin/python
OD=/home/xiaoyan.yu/opsd_outputs
$PY probes/corruption_quality.py --gen_dir $OD/qwen31b_repro_3xh200_gb30/generations --steps 100,150 --tag A --limit 60
$PY probes/corruption_quality.py --gen_dir $OD/qwen31b_declip_B_unclipped/generations --steps 100,150 --tag B --limit 60
echo "=== 裁决 ==="
$PY - <<'PYEOF'
import json
A=json.load(open("probes/analysis/corruption_quality_A.json"))["steps"]
B=json.load(open("probes/analysis/corruption_quality_B.json"))["steps"]
for s in ["100","150"]:
    a=A.get(s,{}).get("mean_jsd_per_token"); b=B.get(s,{}).get("mean_jsd_per_token")
    if a and b:
        r=b/a
        verdict="copying驱动→C/D靶点正确,投正式(P-c存活)" if r>=3 else ("冲突/style驱动→C/D够不到,取消正式,代码归档" if r<=1.5 else "中间带,需人判")
        print(f"step{s}: A={a:.5f} B={b:.5f} B/A={r:.2f}x -> {verdict}")
PYEOF
echo "=== exit $? DONE ==="
