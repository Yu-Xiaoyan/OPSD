#!/bin/bash
#PBS -N tier1_paper_opsd
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=12:ngpus=3
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail

module purge
module load anaconda/2025
module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate opsd

cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1
export DS_SKIP_CUDA_CHECK=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

mkdir -p pbs/logs
exec > "pbs/logs/tier1_paper_opsd.${PBS_JOBID}.log" 2>&1

echo "Job: ${PBS_JOBID}  Node: $(hostname)  GPU: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L
df -h ~ | tail -1

echo "=== Tier 1: paper-OPSD v1 faithful reproduction (leakage bridge main experiment) ==="
echo "    TM-on, 2048, fixed_teacher KEPT, clip 0, paper v1 mild guard, 300 steps @ save 50"
bash scripts/run_tier1_paper_opsd.sh
rc=$?
echo "=== exit code: ${rc} ==="
echo "=== DONE ==="
exit $rc
