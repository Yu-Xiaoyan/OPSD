#!/bin/bash
#PBS -N tier2_dynamic
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=12:ngpus=3
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail

module purge
module load anaconda/2025
module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate opsd

cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1
export HF_HUB_OFFLINE=1
export DS_SKIP_CUDA_CHECK=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)
    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))
    export CUDA_VISIBLE_DEVICES
fi

mkdir -p pbs/logs
exec > "pbs/logs/tier2_dynamic.${PBS_JOBID}.log" 2>&1

echo "Job: ${PBS_JOBID}  Node: $(hostname)  GPU: ${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L

echo "=== Tier 2: dynamic-teacher variant (BEYOND paper; run only if Tier 1 negative) ==="
echo "    = Tier 1 minus --fixed_teacher (teacher-student feedback loop)"
bash scripts/run_tier2_dynamic.sh
rc=$?
echo "=== exit code: ${rc} ==="
echo "=== DONE ==="
exit $rc
