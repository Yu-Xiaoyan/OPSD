#!/bin/bash
#PBS -N v2attr
#PBS -P ds_ccds_wei.lu
#PBS -q gpu_ded
#PBS -l select=1:ncpus=8:ngpus=2
#PBS -l walltime=03:00:00
#PBS -j oe
# v2 死因归因: noCp(纯B)+noB(纯C′) 的 ckpt100 AIME24 avg@12 单点. 预注册见 docs/copy.md.
set -uo pipefail
module purge; module load anaconda/2025; module load cuda/13.1
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"; conda activate opsd
cd /home/xiaoyan.yu/projects/OPSD
export PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 NCCL_P2P_DISABLE=1 DS_SKIP_CUDA_CHECK=1
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH
if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then
  n=$(echo "${CUDA_VISIBLE_DEVICES}"|tr ',' '\n'|wc -l); CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((n-1))); export CUDA_VISIBLE_DEVICES
fi
mkdir -p pbs/logs results/v2_attribution
exec > "pbs/logs/v2attr.${PBS_JOBID}.log" 2>&1
echo "Job ${PBS_JOBID} $(hostname)"; nvidia-smi -L
OD=/home/xiaoyan.yu/opsd_outputs; BM=/home/xiaoyan.yu/models/Qwen3-1.7B
echo "=== noCp (纯B) ckpt100 AIME24 avg@12 ==="
BASE_MODEL="$BM" MODEL_DIR="$OD/qwen31b_v2_noCp" TAG="noCp" OUT="results/v2_attribution" DATASETS="aime24" VAL_N=12 STEPS="100" NGPU=2 bash scripts/run_eval_matrix.sh
echo "=== noB (纯C′) ckpt100 AIME24 avg@12 ==="
BASE_MODEL="$BM" MODEL_DIR="$OD/qwen31b_v2_noB" TAG="noB" OUT="results/v2_attribution" DATASETS="aime24" VAL_N=12 STEPS="100" NGPU=2 bash scripts/run_eval_matrix.sh
echo "=== exit $? DONE ==="
